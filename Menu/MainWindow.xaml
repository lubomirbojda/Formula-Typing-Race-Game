<Window x:Class="Menu.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Menu"
        mc:Ignorable="d"
        Title="Menu" Height="650" Width="600">

    <Window.Background>
        <ImageBrush ImageSource="/resources/pozadie.png"/>
    </Window.Background>

    <Grid x:Name="Menu1" Visibility="Visible">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button BorderBrush="DarkRed" BorderThickness="5" Grid.Row="1" Width="200" Height="80" x:Name="HratButton" Visibility="Visible"
                FontSize="20" FontWeight="ExtraBold" Background="DarkGray" Foreground="DarkRed" Content="HRAŤ" Margin="20" Click="HratButton_Click"/>

        <Button BorderBrush="DarkRed" BorderThickness="5" Grid.Row="3" Width="200" Height="80" x:Name="VypnutButton" Visibility="Visible"
                FontSize="20" FontWeight="ExtraBold" Background="DarkGray" Foreground="DarkRed" Content="VYPNÚŤ" Margin="20" Click="VypnutButton_Click"/>



        <Button BorderBrush="DarkRed" BorderThickness="5" Grid.Row="1" Width="200" Height="80" Visibility="Collapsed" x:Name="LahkaButton"
            FontSize="20" FontWeight="ExtraBold" Background="DarkGray" Foreground="DarkRed" Content="ĽAHKÁ" Margin="20" Click="LahkaButton_Click"/>

        <Button BorderBrush="DarkRed" BorderThickness="5" Grid.Row="2" Width="200" Height="80" Visibility="Collapsed" x:Name="StrednaButton"
            FontSize="20" FontWeight="ExtraBold" Background="DarkGray" Foreground="DarkRed" Content="STREDNÁ" Margin="20" Click="StrednaButton_Click"/>

        <Button BorderBrush="DarkRed" BorderThickness="5" Grid.Row="3" Width="200" Height="80" Visibility="Collapsed" x:Name="TazkaButton"
            FontSize="20" FontWeight="ExtraBold" Background="DarkGray" Foreground="DarkRed" Content="ŤAŽKÁ" Margin="20" Click="TazkaButton_Click"/>

        <Button BorderBrush="DarkRed" BorderThickness="5" Grid.Row="4" Width="200" Height="80" Visibility="Collapsed" x:Name="SpatButton"
            FontSize="20" FontWeight="ExtraBold" Background="DarkGray" Foreground="DarkRed" Content="⇐SPÄŤ" Margin="20" Click="SpatButton_Click"/>


        <TextBlock x:Name="TextVyhraPrehra" Grid.Row="0" Foreground="DarkRed" TextDecorations="Underline" FontWeight="ExtraBold" FontSize="40" Text="VYHRAL SI" VerticalAlignment="Center"
                   HorizontalAlignment="Center" Background="DarkGray" Padding="20" Visibility="Collapsed"/>

        <TextBlock x:Name="FinalnyCas" Grid.Row="1" Foreground="DarkRed" FontWeight="ExtraBold" FontSize="30" Text="ČAS:" VerticalAlignment="Center" 
                   HorizontalAlignment="Center" Background="DarkGray" Padding="10" Margin="15" Visibility="Collapsed"/>

        <Button BorderBrush="DarkRed" BorderThickness="5" Grid.Row="2" Width="200" Height="80" x:Name="OpakovatButton" Visibility="Collapsed"
        FontSize="20" FontWeight="ExtraBold" Background="DarkGray" Foreground="DarkRed" Content="OPAKOVAŤ" Margin="20" Click="OpakovatButton_Click"/>


    </Grid>


</Window>
